# Widget Preview related
.widget_preview/

# Android 本地环境（含本机 SDK 绝对路径，禁止提交）
/android/local.properties
/android/.gradle/
/android/captures/
*.jks
*.keystore
/android/key.properties
# 兜底：签名配置若被挪到别处（如 android/app/key.properties）同样禁止入库
key.properties

# Gradle 缓存（沙箱不允许删 C:\Users\panda\.gradle，故挪到工作区内）
/.gradle-home/

# 构建产物（android/ 根级 build 目录）
/android/build/

# 待删临时目录（旧缓存搬运残留，可安全清理）
/.trash*/

# 真实账单样本（含隐私，只留本机）
test/fixtures/*-real.*

# 走查截图（二进制，只留本机）
/.workbuddy/shots/
# 按批次命名的走查中间产物目录（如 qa-f79 → F7.9）
/.workbuddy/qa-*/
# 兜底：.workbuddy 根下散落的截图同样不入库
/.workbuddy/*.png

# 会话记忆（逐日工作日志，只留本机）
/.workbuddy/memory/

# 本地回收站（safe-delete shim 拦 rm，删文件一律 mv 到这里）
/.workbuddy/trash/

# tool/ 下 Python 脚本的字节码缓存（此前无规则，`git add .` 会误入库）
__pycache__/
*.pyc

